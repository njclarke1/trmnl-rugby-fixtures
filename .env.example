# Portainer → Stacks → <stack> → Environment variables. No secrets needed:
# the club feed is keyless. Values shown are the Bristol defaults.
STACK_TAG=bristol
CONTAINER_NAME=trmnl-bristol-api
HOST_PORT=3459
PUBLIC_BASE_URL=http://192.168.68.111:3459
TEAM_NAME=Bristol Bears
TEAM_BADGE=BB
FIXTURES_SOURCE=club_wp
CLUB_FEED_CATEGORY=men
# Blank = derived from the date (2026/27 → 202601). Override only if the club
# numbers a season unexpectedly, e.g. SEASON_IDS=202601,202701
SEASON_IDS=
# Set once a season: champions | challenge (the feed says "European Cup" for both)
EURO_TIER=champions
TBC_HORIZON_DAYS=42
OWNED_CHANNELS=sky,tnt,bbc,itv,channel4,channel5,s4c
